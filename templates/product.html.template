<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{title}} — {{price}} | IndianDeals2Buy</title>
<meta name="description" content="{{meta_description}}">
<link rel="canonical" href="{{canonical_url}}">
<meta property="og:type" content="product">
<meta property="og:title" content="{{title}}">
<meta property="og:description" content="{{meta_description}}">
{{og_image_tag}}<meta property="og:url" content="{{canonical_url}}">
<meta property="og:site_name" content="IndianDeals2Buy">
<meta name="twitter:card" content="summary_large_image">
<link rel="stylesheet" href="../style.css">
</head>
<body>
<header class="site-header">
  <a class="site-logo" href="../index.html">IndianDeals2Buy</a>
</header>
<main class="product-page">
  <nav class="breadcrumb"><a href="../index.html">&larr; All deals</a> / <span>{{category}}</span></nav>
  <article class="product-card">
{{image_block}}    <div class="product-info">
      <h1>{{title}}</h1>
      <p class="price">{{price}}</p>
      <p class="description">{{description}}</p>
      <ul class="features">
{{features_html}}
      </ul>
      <a class="buy-button" href="{{affiliate_url}}" rel="nofollow sponsored noopener" target="_blank">Buy on Amazon.in&nbsp;&rarr;</a>
      <p class="disclosure">As an Amazon Associate I earn from qualifying purchases. Price shown was accurate at time of listing and may have changed — check the current price on Amazon.</p>
    </div>
  </article>
</main>
<footer class="site-footer">
  <p><a href="../index.html">Back to all deals</a></p>
  <p class="disclosure">As an Amazon Associate I earn from qualifying purchases.</p>
</footer>
</body>
</html>
